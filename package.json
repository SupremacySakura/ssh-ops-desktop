{
  "name": "ssh-ops-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:agent && pnpm --filter @opspilot/desktop dev",
    "build:agent": "pnpm --filter @opspilot/agent-runtime build",
    "build:desktop": "pnpm build:agent && pnpm --filter @opspilot/desktop build",
    "build:desktop:native-e2e": "pnpm build:agent && pnpm --filter @opspilot/desktop build:native-e2e",
    "build:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "tauri": "tauri",
    "build:e2e:native": "tauri build --debug --features native-e2e --config src-tauri/tauri.native-e2e.conf.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:packages && pnpm test:smoke",
    "test:packages": "pnpm -r test",
    "test:smoke": "node --test tests/smoke/workspace.test.mjs",
    "test:e2e:renderer": "playwright test --config playwright.config.ts",
    "test:e2e:native": "wdio run tests/e2e/native/wdio.conf.ts",
    "test:e2e": "pnpm test:e2e:renderer && pnpm build:e2e:native && pnpm test:e2e:native",
    "contracts:check": "pnpm --filter @opspilot/contracts test --run && cargo test -p opspilot-domain --test contract_fixtures",
    "verify:static": "pnpm lint && pnpm typecheck && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
