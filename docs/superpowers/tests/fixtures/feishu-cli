#!/usr/bin/env bash
set -euo pipefail

: "${FEISHU_CLI_TEST_LOG:?FEISHU_CLI_TEST_LOG is required}"

if [[ "${1:-}" == "auth" && "${2:-}" == "token" ]]; then
  printf 'fixture-user-token\n'
  exit 0
fi

if [[ "${1:-}" == "doc" && "${2:-}" == "content-update" ]]; then
  printf '%s\n' "${3:-}" >> "$FEISHU_CLI_TEST_LOG"
  printf '{}\n'
  exit 0
fi

printf 'unexpected feishu-cli invocation:' >&2
printf ' %q' "$@" >&2
printf '\n' >&2
exit 1
