{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal IPC access for the Harbor main window.",
  "windows": ["main"],
  "permissions": [
    "allow-core-health",
    "allow-server-list",
    "allow-server-create",
    "allow-server-update",
    "allow-server-delete",
    "allow-server-credential-set",
    "allow-server-group-list",
    "allow-server-group-create",
    "allow-server-group-update",
    "allow-server-group-delete",
    "allow-connection-connect",
    "allow-connection-trust-host-key",
    "allow-connection-disconnect",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "core:event:default"
  ]
}
