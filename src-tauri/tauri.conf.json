{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpsPilot",
  "version": "0.1.0",
  "identifier": "com.opspilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpsPilot",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/opspilot-agent-node"],
    "resources": ["resources/agent-runtime/**/*"]
  }
}
